# Copy to /etc/klothulhu/klothulhu.env and chmod 600.

ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# One entry per client, "client_id:secret". Secrets >= 16 chars.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
KLOTHULHU_TOKENS=konnos:CHANGE_ME_konnos_secret,pi:CHANGE_ME_pi_secret

# Bind ONLY to the Tailscale IP of seb01 (tailscale ip -4). Never 0.0.0.0.
KLOTHULHU_HOST=100.x.y.z
KLOTHULHU_PORT=8765

# Narrator (D16). The model thinks by default and thinking counts toward max_tokens: keep effort low.
KLOTHULHU_MODEL=claude-haiku-5-5
KLOTHULHU_EFFORT=low
KLOTHULHU_MAX_TOKENS=1024

# Director (D14): stages each beat as a scene. 0 = scenes are all null (clients use their own staging).
KLOTHULHU_DIRECTOR=1
KLOTHULHU_DIRECTOR_MODEL=claude-haiku-5-5
KLOTHULHU_DIRECTOR_EFFORT=low
KLOTHULHU_DIRECTOR_TIMEOUT=10
# 0 = director without thinking (default, D20: same quality, shorter tail latency); 1 = it thinks.
KLOTHULHU_DIRECTOR_THINKING=0

KLOTHULHU_HISTORY_TURNS=6
KLOTHULHU_HISTORY_TTL_MIN=30

# 1 = canned replies, no API calls. Useful to test clients for free.
KLOTHULHU_FAKE=0

# Memoria larga (fase 7, D34-D42). Apagada por defecto: desplegar el código no cambia nada.
KLOTHULHU_MEMORIA=0
# Freno de gasto (D40): tope en dólares sobre el gasto total guardado en la BD (escritor + embeddings).
KLOTHULHU_MEMORIA_TOPE=1.0
KLOTHULHU_DB_HOST=localhost
KLOTHULHU_DB_PORT=3306
KLOTHULHU_DB_USER=klothulhu
KLOTHULHU_DB_PASSWORD=CHANGE_ME
KLOTHULHU_DB_NAME=klothulhu
KLOTHULHU_QDRANT_URL=http://localhost:6333
KLOTHULHU_QDRANT_COLECCION=klothulhu_memoria
OPENAI_API_KEY=sk-CHANGE_ME
# LogCentral (D42): ProtectSystem=strict deja /data en solo lectura; la unidad permite escribir aquí.
LOGCENTRAL_LOG_DIR=/data/klothulhu/logs
