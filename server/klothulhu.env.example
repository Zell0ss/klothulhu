# Copy to /etc/klothulhu/klothulhu.env and chmod 600.

ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# One entry per client, "client_id:secret". Secrets >= 16 chars.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
KLOTHULHU_TOKENS=konnos:CHANGE_ME_konnos_secret,pi:CHANGE_ME_pi_secret

# Bind ONLY to the Tailscale IP of seb01 (tailscale ip -4). Never 0.0.0.0.
KLOTHULHU_HOST=100.x.y.z
KLOTHULHU_PORT=8765

# Narrator (D16). The model thinks by default and thinking counts toward max_tokens: keep effort low.
KLOTHULHU_MODEL=claude-haiku-5-5
KLOTHULHU_EFFORT=low
KLOTHULHU_MAX_TOKENS=1024

# Director (D14): stages each beat as a scene. 0 = scenes are all null (clients use their own staging).
KLOTHULHU_DIRECTOR=1
KLOTHULHU_DIRECTOR_MODEL=claude-haiku-5-5
KLOTHULHU_DIRECTOR_EFFORT=low
KLOTHULHU_DIRECTOR_TIMEOUT=10

KLOTHULHU_HISTORY_TURNS=6
KLOTHULHU_HISTORY_TTL_MIN=30

# 1 = canned replies, no API calls. Useful to test clients for free.
KLOTHULHU_FAKE=0
