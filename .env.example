# Desarrollo: copiar a .env (sin versionar) en el worktree. Nunca apunta a la BD de producción:
# esa solo la fija /etc/klothulhu/klothulhu.env, que lee la unidad systemd.
KLOTHULHU_FAKE=1
KLOTHULHU_MEMORIA=0
KLOTHULHU_DB_HOST=localhost
KLOTHULHU_DB_PORT=3306
KLOTHULHU_DB_USER=klothulhu_dev
KLOTHULHU_DB_PASSWORD=CHANGE_ME
KLOTHULHU_DB_NAME=klothulhu_dev
KLOTHULHU_QDRANT_URL=http://localhost:6333
KLOTHULHU_QDRANT_COLECCION=klothulhu_memoria_dev
# Solo para la pasada [API] T10 (no la pongas aquí; se pasa en el entorno de esa orden):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
